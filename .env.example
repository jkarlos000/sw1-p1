# Sistema UML Colaborativo - Variables de Entorno
# Copiar este archivo a .env y configurar valores

# ====================================
# Base de Datos PostgreSQL
# ====================================
POSTGRES_DB=parcial1sw1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ====================================
# Backend
# ====================================
BACKEND_PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# ====================================
# Inteligencia Artificial (Opcional)
# ====================================
# Claude (Recomendado) - Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (Alternativa) - Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo por defecto
# Opciones: claude-sonnet-4.5, claude-opus-4, gpt-4, gpt-3.5-turbo
MODELO_IA=claude-sonnet-4.5

# ====================================
# Transcripción Multimodal (Opcional)
# ====================================
# Proveedor de transcripción
# Opciones: assemblyai, openai, deepgram, google, local
TRANSCRIPTION_PROVIDER=assemblyai

# AssemblyAI - $0.015/min - Obtener en: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Deepgram - $0.0043/min - Obtener en: https://deepgram.com/
DEEPGRAM_API_KEY=

# Google Cloud Speech - 60min gratis/mes
# Ruta al archivo credentials.json
GOOGLE_APPLICATION_CREDENTIALS=

# ====================================
# Frontend
# ====================================
# URL del backend (Docker usa nombre del servicio)
BACKEND_URL=http://backend:3000

# ====================================
# Nginx (Producción)
# ====================================
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=localhost

# ====================================
# Desarrollo Local (sin Docker)
# ====================================
# Descomentar estas líneas para desarrollo local:
# DB_HOST=localhost
# BACKEND_URL=http://localhost:3000
