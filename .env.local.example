# =====================================================
# CONFIGURACIÓN LOCAL PARA DESARROLLO
# =====================================================
# Este archivo es SOLO para desarrollo local
# En VPS, copiar .env.production.example como .env
# y editar con valores reales del servidor

# =====================================================
# ENTORNO
# =====================================================
NODE_ENV=development
ENVIRONMENT=development

# =====================================================
# PUERTOS
# =====================================================
BACKEND_PORT=3000
POSTGRES_PORT=5432

# =====================================================
# BASE DE DATOS - LOCAL
# =====================================================
POSTGRES_DB=parcial1sw1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DB_HOST=localhost
DB_PORT=5432
DB_NAME=parcial1sw1
DB_USER=postgres
DB_PASSWORD=postgres

# =====================================================
# URLS - LOCALHOST PARA DESARROLLO
# =====================================================
# En desarrollo, backend corre en localhost:3000
# Frontend corre en localhost:4200
# Se comunican via localhost

DOMAIN=localhost
API_URL=http://localhost:3000
WS_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

CORS_ORIGIN=*

# =====================================================
# APIs EXTERNAS - OPCIONAL
# =====================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODELO_IA=claude-sonnet-4.5

TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# =====================================================
# LOGGING - DESARROLLO
# =====================================================
LOG_LEVEL=debug
DEBUG=true

# =====================================================
# SEGURIDAD - DESARROLLO
# =====================================================
# En desarrollo, no importan mucho
# En producción, cambiar por valores seguros
JWT_SECRET=dev_secret_key_no_uses_en_produccion
SESSION_TIMEOUT=1440

# =====================================================
# DOCKER - NO NECESARIO EN DESARROLLO LOCAL
# =====================================================
COMPOSE_PROJECT_NAME=uml-flutter-local
