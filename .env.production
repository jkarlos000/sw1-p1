# ====================================
# Configuración de Producción
# Dominio: uml.jkhoster.com
# ====================================

# PostgreSQL
POSTGRES_DB=parcial1sw1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_ESTO_EN_PRODUCCION_PASSWORD_SEGURO
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000

# Puertos Nginx
HTTP_PORT=80
HTTPS_PORT=443

# URLs Públicas (las que verá el navegador del cliente)
API_URL=https://uml.jkhoster.com/api
WS_URL=https://uml.jkhoster.com
BACKEND_URL=https://uml.jkhoster.com/api

# CORS - Permitir solo tu dominio
CORS_ORIGIN=https://uml.jkhoster.com

# ====================================
# API Keys - IA
# ====================================

# Anthropic Claude (REQUERIDO para análisis de diagramas)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# OpenAI (OPCIONAL - para transcripción Whisper)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# Modelo IA
MODELO_IA=claude-sonnet-4.5

# ====================================
# Transcripción Multimodal (OPCIONAL)
# ====================================

# Proveedor: assemblyai, openai, deepgram, google, whisper-local
TRANSCRIPTION_PROVIDER=assemblyai

# AssemblyAI (Recomendado para español)
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Deepgram (Más rápido)
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Google Cloud Speech (60 min gratis/mes)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ====================================
# SSL (Let's Encrypt)
# ====================================

# Email para notificaciones de renovación de certificados
CERTBOT_EMAIL=tu-email@ejemplo.com

# Dominio
DOMAIN=uml.jkhoster.com
