# =====================================================
# CONFIGURACIÓN DE PRODUCCIÓN PARA VPS
# =====================================================
# 
# 🔴 INSTRUCCIONES CRÍTICAS:
# 
# 1. COPIA este archivo en tu VPS como .env:
#    $ cp .env.production.example .env
#
# 2. EDITA los valores (especialmente contraseñas y URLs)
#    $ nano .env
#
# 3. GUARDA y CIERRA: Ctrl+X, Y, Enter
#
# 4. NUNCA commitees .env a GitHub (.gitignore lo protege)
#
# 5. Cambia TODOS los valores entre comillas:
#    - POSTGRES_PASSWORD (línea ~30)
#    - DB_PASSWORD (línea ~35)
#    - JWT_SECRET (línea ~95)
#
# 6. URLs deben apuntar a tu dominio, NO a localhost
#
# =====================================================

# =====================================================
# ENTORNO
# =====================================================
NODE_ENV=production
ENVIRONMENT=production

# =====================================================
# PUERTOS
# =====================================================
# Backend
BACKEND_PORT=3000

# PostgreSQL
POSTGRES_PORT=5432

# Nginx HTTP/HTTPS
HTTP_PORT=80
HTTPS_PORT=443

# =====================================================
# BASE DE DATOS - POSTGRESQL
# =====================================================
POSTGRES_DB=parcial1sw1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production_12345

# Backend
DB_HOST=postgres
DB_PORT=5432
DB_NAME=parcial1sw1
DB_USER=postgres
DB_PASSWORD=change_me_in_production_12345

# =====================================================
# URLS Y DOMINIOS
# =====================================================
# Dominio principal
DOMAIN=uml.jkhoster.com
API_URL=https://uml.jkhoster.com/api
WS_URL=https://uml.jkhoster.com
BACKEND_URL=https://uml.jkhoster.com/api

# CORS
CORS_ORIGIN=https://uml.jkhoster.com

# =====================================================
# CERTIFICADO SSL
# =====================================================
# Let's Encrypt (automático con Certbot)
SSL_CERT_PATH=/etc/letsencrypt/live/uml.jkhoster.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/uml.jkhoster.com/privkey.pem

# =====================================================
# APIS EXTERNAS - IA Y TRANSCRIPCIÓN (OPCIONAL)
# =====================================================

# Anthropic Claude (Recomendado)
ANTHROPIC_API_KEY=sk-ant-v1-xxxxx

# OpenAI (Alternativa)
OPENAI_API_KEY=sk-xxxxx

# Modelo IA a usar
MODELO_IA=claude-sonnet-4.5

# Transcripción Multimodal
TRANSCRIPTION_PROVIDER=assemblyai  # o 'deepgram' o 'google'
ASSEMBLYAI_API_KEY=xxxxx
DEEPGRAM_API_KEY=xxxxx
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-creds.json

# =====================================================
# LOGGING Y DEBUGGING
# =====================================================
LOG_LEVEL=info          # debug, info, warn, error
LOG_FILE=/var/log/uml-backend.log

# Debug mode (false en producción)
DEBUG=false

# =====================================================
# SEGURIDAD
# =====================================================
# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_12345

# Session timeout (minutos)
SESSION_TIMEOUT=1440

# =====================================================
# DOCKER
# =====================================================
# Valores usados por docker-compose
COMPOSE_PROJECT_NAME=uml-flutter
COMPOSE_FILE=docker-compose.yml

# =====================================================
# BACKUPS
# =====================================================
BACKUP_DIR=/backups/docker-uml-flutter
BACKUP_RETENTION_DAYS=7

# =====================================================
# MONITOREO (OPCIONAL)
# =====================================================
# Sentry (Error tracking)
SENTRY_DSN=

# Email de alertas
ADMIN_EMAIL=admin@example.com

# =====================================================
# NOTAS IMPORTANTES
# =====================================================
# 1. CAMBIAR TODAS LAS CONTRASEÑAS Y CLAVES ANTES DE PRODUCCIÓN
# 2. No commitear este archivo a Git (usar .gitignore)
# 3. Usar strong passwords: min 16 caracteres, incluir números y símbolos
# 4. POSTGRES_PASSWORD y DB_PASSWORD DEBEN SER IGUALES
# 5. Hacer backup de este archivo en lugar seguro
# 6. En VPS, usar permisos restrictivos: chmod 600 .env
# 7. Verificar todas las URLs apunten a tu dominio real
# 8. Para Certbot, el certificado DEBE existir en /etc/letsencrypt/live/
