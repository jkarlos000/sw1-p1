-- =====================================================
-- SCHEMA PARA SOPORTE MULTIMODAL (Audio + Imágenes)
-- =====================================================

-- Tabla para múltiples attachments por mensaje
CREATE TABLE IF NOT EXISTS mensaje_attachment (
    id SERIAL PRIMARY KEY,
    mensaje_id INTEGER NOT NULL REFERENCES mensaje_chat_ia(id) ON DELETE CASCADE,
    tipo VARCHAR(20) NOT NULL CHECK (tipo IN ('audio', 'imagen')),
    archivo_url VARCHAR(500) NOT NULL,
    archivo_nombre VARCHAR(255) NOT NULL,
    archivo_tamano INTEGER, -- bytes
    mime_type VARCHAR(100),
    
    -- Solo para audio
    transcripcion TEXT,
    duracion_segundos DECIMAL(10,2),
    servicio_transcripcion VARCHAR(50), -- 'whisper', 'assemblyai', 'deepgram', etc.
    
    -- Solo para imágenes
    ancho INTEGER,
    alto INTEGER,
    analisis_ia JSONB, -- Resultado del análisis visual de Claude
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Índices para la tabla mensaje_attachment
CREATE INDEX IF NOT EXISTS idx_mensaje_attachment_mensaje ON mensaje_attachment(mensaje_id);
CREATE INDEX IF NOT EXISTS idx_mensaje_attachment_tipo ON mensaje_attachment(tipo);

-- Agregar columna para indicar si un mensaje tiene attachments
ALTER TABLE mensaje_chat_ia 
ADD COLUMN IF NOT EXISTS tiene_attachments BOOLEAN DEFAULT FALSE;

-- Agregar columna para metadata multimodal
ALTER TABLE mensaje_chat_ia 
ADD COLUMN IF NOT EXISTS metadata_multimodal JSONB;

-- Índices para rendimiento
CREATE INDEX IF NOT EXISTS idx_mensaje_chat_ia_attachments 
ON mensaje_chat_ia(tiene_attachments) WHERE tiene_attachments = TRUE;

-- Comentarios
COMMENT ON TABLE mensaje_attachment IS 'Almacena múltiples archivos (audio/imagen) adjuntos a mensajes del chat IA';
COMMENT ON COLUMN mensaje_attachment.transcripcion IS 'Texto transcrito del audio (Whisper, AssemblyAI, etc.)';
COMMENT ON COLUMN mensaje_attachment.analisis_ia IS 'Análisis visual de Claude: clases detectadas, estructura UML, etc.';
COMMENT ON COLUMN mensaje_chat_ia.metadata_multimodal IS 'Resumen: cantidad de audios, imágenes, duración total, etc.';
